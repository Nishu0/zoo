FROM --platform=$BUILDPLATFORM golang:1.26-bookworm AS build
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /src/gateway
COPY gateway/go.mod gateway/go.sum ./
COPY node/go.mod node/go.sum ../node/
RUN go mod download
COPY gateway/ ./
COPY node/ ../node/
COPY pyproject.toml /src/pyproject.toml
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /zoo-gateway .
RUN cd ../node && version=$(sed -n 's/^version = "\(.*\)"/\1/p' ../pyproject.toml) && mkdir -p /node-dist \
 && for t in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64; do \
      os=${t%/*}; arch=${t#*/}; ext=$([ "$os" = windows ] && echo .exe || true); \
      CGO_ENABLED=0 GOOS=$os GOARCH=$arch go build -trimpath -ldflags="-s -w -X main.version=$version" -o /node-dist/zoo-node-$os-$arch$ext . || exit 1; \
    done \
 && echo "$version" > /node-dist/VERSION

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /zoo-gateway /usr/local/bin/zoo-gateway
COPY --from=build /node-dist/ /app/node/dist/
WORKDIR /app
ENV ZOO_NODE_DIST=/app/node/dist
EXPOSE 7443 7444 8001 8002
ENTRYPOINT ["/usr/local/bin/zoo-gateway"]
