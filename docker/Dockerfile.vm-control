FROM --platform=$BUILDPLATFORM golang:1.26.7-bookworm AS build
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /src/vm-control
COPY go/vm-control/go.mod go/vm-control/go.sum ./
RUN go mod download
COPY go/vm-control/ ./
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /zoo-vm-control .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /zoo-vm-control /usr/local/bin/zoo-vm-control
EXPOSE 9444
ENTRYPOINT ["/usr/local/bin/zoo-vm-control"]
