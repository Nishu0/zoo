# zoo-guest for macOS and Windows VMs, which the API copies into each VM at boot (apps/server/macos.py, apps/server/windows.py)
FROM --platform=$BUILDPLATFORM golang:1.26-bookworm AS guest
WORKDIR /src
COPY go/guest/go.mod go/guest/go.sum ./
RUN go mod download
COPY go/guest/ ./
RUN CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -trimpath -ldflags="-s -w" -o /zoo-guest-darwin-arm64 . \
 && CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -trimpath -ldflags="-s -w -H windowsgui" -o /zoo-guest-windows-amd64.exe .

FROM --platform=$BUILDPLATFORM golang:1.26-bookworm AS egress
WORKDIR /src
COPY go/egress/go.mod go/egress/go.sum ./
RUN go mod download
COPY go/egress/ ./
RUN CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -trimpath -ldflags="-s -w" -o /zoo-egress-darwin-arm64 . \
 && CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -trimpath -ldflags="-s -w -H windowsgui" -o /zoo-egress-windows-amd64.exe .

# zoo-node for macOS and Windows, which the API serves to installers and pushes to nodes on another version
FROM --platform=$BUILDPLATFORM golang:1.26-bookworm AS node
WORKDIR /src
COPY go/node/go.mod go/node/go.sum ./
RUN go mod download
COPY go/node/ ./
COPY pyproject.toml /pyproject.toml
RUN version=$(sed -n 's/^version = "\(.*\)"/\1/p' /pyproject.toml) && mkdir -p /dist \
 && for t in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64; do \
      os=${t%/*}; arch=${t#*/}; ext=$([ "$os" = windows ] && echo .exe || true); \
      CGO_ENABLED=0 GOOS=$os GOARCH=$arch go build -trimpath -ldflags="-s -w -X main.version=$version" -o /dist/zoo-node-$os-$arch$ext . || exit 1; \
    done && echo "$version" > /dist/VERSION

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends curl openssh-client postgresql-client \
    && curl -fsSL --retry 5 --retry-all-errors https://github.com/pressly/goose/releases/download/v3.29.0/"goose_linux_$(dpkg --print-architecture | sed 's/amd64/x86_64/')" -o /usr/local/bin/goose \
    && chmod +x /usr/local/bin/goose \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY . .
COPY --from=guest /zoo-guest-darwin-arm64 /zoo-guest-windows-amd64.exe go/guest/dist/
COPY --from=egress /zoo-egress-darwin-arm64 /zoo-egress-windows-amd64.exe go/egress/dist/
COPY --from=node /dist/ go/node/dist/

ENV HOST=0.0.0.0 PORT=8000 RELOAD=0 ZOO_NETWORK=zoo
EXPOSE 8000
# migrates Postgres at DATABASE_URL, then starts the API (scripts/start.sh)
CMD ["sh", "scripts/start.sh"]
