#!/usr/bin/env bash
# Operator commands for a Zoo install made by install.sh.
#
#   zoo upgrade [X.Y.Z]   back up the database, move to a release (default: the latest), roll back if it isn't healthy
#   zoo backup            save the database to $ZOO_HOME/backups and print the file
#   zoo restore FILE      replace the database with a backup and restart the API
#   zoo doctor            check KVM, the sandbox runtime, disk, ports, DNS and the API
#   zoo wait              wait until the API and dashboard report healthy
#   zoo version           print the installed release
#   zoo node install --macos [--key KEY ...]
#                         on a Mac: install zoovm and build its base macOS VM unattended (install.sh --node)
#   zoo node install --windows --key KEY [--control-plane URL] [--iso PATH|URL] [--edition NAME]
#                         on Windows (Git Bash, elevated): turn on Hyper-V and OpenSSH and, with --iso, build the
#                         base Windows VM unattended (install-node.ps1)
#
# Sandbox commands (zoo login, create, ls, exec, shell, view, cp, logs, rm) are the Python CLI's
# (pip install 'zoo-sdk[cli]'); this script hands them to it, and it hands operator commands back here.
set -euo pipefail

REPO="chann44/zoo"
ZOO_HOME="${ZOO_HOME:-/opt/zoo}"
HEALTH_TIMEOUT="${ZOO_HEALTH_TIMEOUT:-300}"

say() { printf '\033[1m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[33mwarning: %s\033[0m\n' "$*" >&2; }
die() { printf '\033[31merror: %s\033[0m\n' "$*" >&2; exit 1; }

# the Python CLI's commands: run the first other `zoo` on PATH that isn't a shell script
case "${1:-}" in
    login | create | ls | exec | shell | view | cp | logs | rm)
        self=$(realpath "$0")
        IFS=: read -ra dirs <<< "$PATH"
        for dir in "${dirs[@]}"; do
            cli="$dir/zoo"
            [ -x "$cli" ] && [ "$(realpath "$cli")" != "$self" ] || continue
            head -c 64 "$cli" | grep -q bash && continue
            exec "$cli" "$@"
        done
        die "zoo $1 is part of the zoo CLI: pip install 'zoo-sdk[cli]' (or uv tool install 'zoo-sdk[cli]')" ;;
esac

# zoo node install: sets up this machine as a server for a control plane (install.sh --node), so it runs before
# the check for a control plane install below
if [ "${1:-}" = node ]; then
    [ "${2:-}" = install ] || die "usage: zoo node install --macos|--windows [install.sh options, e.g. --key KEY]"
    case "${3:-}" in
        --macos)
            [ "$(uname -s)" = Darwin ] || die "run this on the Mac"
            shift 3
            curl -fsSL "https://github.com/$REPO/releases/latest/download/install.sh" | sudo bash -s -- --node "$@"
            exit $? ;;
        --windows)
            case "$(uname -s)" in
                MINGW* | MSYS* | CYGWIN*) ;;
                *) die "run this on the Windows machine, in Git Bash started as administrator, or run the PowerShell line from Servers > Add server > Windows" ;;
            esac
            shift 3
            args=()
            while [ $# -gt 0 ]; do
                [ $# -ge 2 ] || die "$1 needs a value"
                case "$1" in
                    --key) args+=(-Key "$2") ;;
                    --control-plane) args+=(-ControlPlane "$2") ;;
                    --iso) args+=(-Iso "$2") ;;
                    --edition) args+=(-Edition "$2") ;;
                    *) die "unknown option $1 (use --key, --control-plane, --iso, --edition)" ;;
                esac
                shift 2
            done
            script="$(mktemp -d)/install-node.ps1"
            curl -fsSL "https://github.com/$REPO/releases/latest/download/install-node.ps1" -o "$script"
            powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$script")" "${args[@]}"
            exit $? ;;
        *) die "usage: zoo node install --macos|--windows [install.sh options, e.g. --key KEY]" ;;
    esac
fi

[ -f "$ZOO_HOME/compose.yml" ] || die "no Zoo install in $ZOO_HOME (set ZOO_HOME)"
cd "$ZOO_HOME"
dc() { docker compose -p zoo "$@"; }
setting() { grep "^$1=" .env 2>/dev/null | tail -n1 | cut -d= -f2-; }

wait_healthy() {
    local deadline=$((SECONDS + HEALTH_TIMEOUT)) service id state
    for service in api web; do
        while :; do
            id=$(dc ps -q "$service" 2>/dev/null || true)
            state=$( [ -n "$id" ] && docker inspect -f '{{.State.Health.Status}}' "$id" 2>/dev/null || echo starting)
            [ "$state" = healthy ] && break
            if [ "$state" = unhealthy ] || [ $SECONDS -ge $deadline ]; then
                warn "$service is $state"
                dc logs --tail 30 "$service" >&2 || true
                return 1
            fi
            sleep 3
        done
    done
}

backup() {
    local name
    name="zoo-$(date -u +%Y%m%d-%H%M%S).dump"
    mkdir -p backups
    # pg_dump's custom format is safe to take while the API is running; zoo restore (and step 25's scheduled
    # backups) put it back with pg_restore
    dc exec -T postgres pg_dump --format=custom --username=zoo zoo > "backups/$name"
    echo "$ZOO_HOME/backups/$name"
}

restore() {
    local file
    file=$(realpath "$1")
    [ -f "$file" ] || die "no such backup: $1"
    say "Restoring $file"
    dc stop api worker gateway
    dc exec -T postgres sh -c 'dropdb --force --if-exists --username=zoo zoo && createdb --username=zoo zoo'
    dc exec -T postgres pg_restore --username=zoo --dbname=zoo --no-owner < "$file"
    dc up -d
    wait_healthy
}

latest() {
    curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$REPO/releases/latest" | sed 's#.*/tag/v##'
}

upgrade() {
    local target="${1:-}" current snapshot db
    target="${target#v}"
    current=$(setting ZOO_VERSION)
    [ -n "$target" ] || target=$(latest)
    [ -n "$target" ] || die "couldn't find the latest release of $REPO"
    if [ "$target" = "$current" ]; then
        say "Already on $current"
        return
    fi
    say "Upgrading Zoo ${current:-?} -> $target"

    snapshot=$(mktemp -d)
    cp compose.yml .env "$snapshot/"
    [ -f Caddyfile ] && cp Caddyfile "$snapshot/"
    db=$(backup)
    say "Database backed up to $db"

    local assets="https://github.com/$REPO/releases/download/v$target"
    curl -fsSL "$assets/compose.yml" -o compose.yml.new && mv compose.yml.new compose.yml
    curl -fsSL "$assets/Caddyfile" -o Caddyfile.new && mv Caddyfile.new Caddyfile
    if grep -q '^ZOO_VERSION=' .env; then
        sed -i "s/^ZOO_VERSION=.*/ZOO_VERSION=$target/" .env
    else
        echo "ZOO_VERSION=$target" >> .env
    fi

    # migrations run when the new API starts; running sandboxes keep their image until restarted on the new one
    if dc pull --quiet && dc up -d --remove-orphans && wait_healthy; then
        if ! { curl -fsSL "$assets/zoo" -o /usr/local/bin/zoo.new && chmod 755 /usr/local/bin/zoo.new \
            && mv /usr/local/bin/zoo.new /usr/local/bin/zoo; }; then
            warn "couldn't update the zoo CLI"
        fi
        rm -rf "$snapshot"
        say "Zoo $target is running"
        return
    fi

    warn "Zoo $target didn't come up healthy; rolling back to ${current:-the previous release}"
    cp "$snapshot"/* .
    rm -rf "$snapshot"
    # restore stops the new API, puts the pre-upgrade database back and starts the previous release
    dc pull --quiet || true
    restore "$db" || warn "the previous release didn't come up healthy either; see zoo doctor"
    die "upgrade to $target failed and was rolled back; the database backup is $db"
}

doctor() {
    local failed=0 runtime free port domain resolved
    ok() { printf '  \033[32mok\033[0m    %s\n' "$*"; }
    bad() { printf '  \033[31mfail\033[0m  %s\n' "$*"; failed=1; }
    note() { printf '  \033[33mwarn\033[0m  %s\n' "$*"; }

    runtime=$(setting ZOO_RUNTIME)
    runtime=${runtime:-kata}
    if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then ok "KVM is available"
    elif [ "$runtime" = runc ]; then note "no KVM; sandboxes run on runc and share the host kernel"
    else bad "/dev/kvm is missing or not accessible, but ZOO_RUNTIME=$runtime"; fi

    if docker info >/dev/null 2>&1; then ok "Docker $(docker version -f '{{.Server.Version}}')"
    else bad "Docker isn't running"; fi
    if docker info -f '{{json .Runtimes}}' 2>/dev/null | grep -q "\"$runtime\""; then
        if [ "$runtime" = runc ] || docker run --rm --runtime "$runtime" alpine:3 true >/dev/null 2>&1; then
            ok "sandbox runtime $runtime starts containers"
        else
            bad "sandbox runtime $runtime is registered but can't start a container"
        fi
    else
        bad "sandbox runtime $runtime isn't registered in /etc/docker/daemon.json"
    fi

    free=$(df -Pk "$(docker info -f '{{.DockerRootDir}}' 2>/dev/null || echo /)" | awk 'NR==2 {print int($4 / 1048576)}')
    if [ "$free" -ge 20 ]; then ok "${free} GB free for images and sandboxes"
    elif [ "$free" -ge 5 ]; then note "only ${free} GB free; each sandbox image is about 2 GB"
    else bad "only ${free} GB free"; fi

    for port in 3000 8000; do
        if dc ps --format '{{.Publishers}}' 2>/dev/null | grep -q ":$port->"; then ok "port $port is served by Zoo"
        elif ss -ltn 2>/dev/null | grep -q ":$port "; then bad "port $port is taken by another process"
        else bad "port $port isn't listening; is Zoo running? (zoo wait)"; fi
    done

    domain=$(setting ZOO_DOMAIN)
    if [ -n "$domain" ]; then
        resolved=$(getent ahostsv4 "$domain" | awk 'NR==1 {print $1}')
        local public
        public=$(setting ZOO_PUBLIC_IP)
        if [ -z "$resolved" ]; then bad "$domain doesn't resolve"
        elif [ -n "$public" ] && [ "$resolved" != "$public" ]; then bad "$domain resolves to $resolved, not $public"
        else ok "$domain resolves to $resolved"; fi
        for port in 80 443; do
            if ss -ltn 2>/dev/null | grep -q ":$port "; then ok "port $port is listening"
            else bad "port $port isn't listening; Caddy needs it for HTTPS"; fi
        done
    fi

    local ready
    if ready=$(curl -fsS --max-time 10 http://127.0.0.1:8000/readyz 2>&1); then ok "API is ready"
    else bad "API isn't ready: ${ready:-no answer on :8000}"; fi

    return $failed
}

case "${1:-}" in
    upgrade) shift; upgrade "${1:-}" ;;
    backup) backup ;;
    restore) [ $# -eq 2 ] || die "usage: zoo restore FILE"; restore "$2" ;;
    doctor) doctor ;;
    wait) wait_healthy ;;
    version) echo "${ZOO_VERSION:-$(setting ZOO_VERSION)}" ;;
    *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; [ -z "${1:-}" ] || [ "$1" = help ] || exit 2 ;;
esac
