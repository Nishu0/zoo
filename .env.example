JWT_SECRET=change-me-to-a-long-random-string
# encrypts vault secrets, agent keys, app profiles and VNC passwords; required for new installs,
# separate from JWT_SECRET (openssl rand -base64 48)
ZOO_SECRETS_KEY=change-me-to-another-long-random-string
# old keys, comma separated, kept only until `make rotate-secrets` has run
ZOO_SECRETS_KEY_PREVIOUS=
# Postgres connection the API uses (required); compose runs postgres:17 for dev
DATABASE_URL=postgresql://zoo:zoo@postgres:5432/zoo
# password of the compose postgres service; must match the one in DATABASE_URL
POSTGRES_PASSWORD=zoo
# S3 object storage for profiles, agent screenshots and backups (required); compose runs SeaweedFS for dev
ZOO_OBJECT_STORE=s3://zoo
ZOO_S3_ENDPOINT=http://seaweedfs:8333
# dev credentials, also accepted by the seaweedfs service; override with real AWS keys for S3
AWS_ACCESS_KEY_ID=zoo
AWS_SECRET_ACCESS_KEY=zoozoozoo
ADMIN_EMAILS=you@example.com
CORS_ORIGINS=http://localhost:3000
# proxies whose X-Forwarded-For the API trusts for per-IP rate limits (e.g. Caddy's address)
FORWARDED_ALLOW_IPS=127.0.0.1
# API URL the dashboard calls, read when the web container starts
ZOO_API_URL=http://localhost:8000
ZOO_SSH_DIR=~/.ssh
ZOO_DOMAIN=zoo.example.com
ZOO_GRAFANA_DOMAIN=grafana.zoo.example.com
OTEL_EXPORTER_OTLP_ENDPOINT=
ZOO_PUBLIC_IP=
ZOO_RUNTIME=kata
# release to run (install.sh pins it; `zoo upgrade` moves it); images come from ZOO_REGISTRY
ZOO_VERSION=latest
ZOO_REGISTRY=docker.io/chann44
# override one sandbox image, e.g. a custom build
# ZOO_SANDBOX_IMAGE=docker.io/chann44/zoo-sandbox-desktop:latest
# ZOO_CODE_IMAGE=docker.io/chann44/zoo-sandbox-code:latest
ANTHROPIC_API_KEY=
ZOO_AGENT_MODEL=anthropic/claude-sonnet-5-5
# other providers a run can pick (POST /sandboxes/{id}/agent with "provider"); a workspace can keep its own keys in
# the vault as AGENT_<PROVIDER>_API_KEY instead
OPENAI_API_KEY=
XAI_API_KEY=
# origins that may put a viewer link in an iframe, space-separated (e.g. https://app.example.com); empty: none
ZOO_EMBED_ORIGINS=
ZOO_MAX_VIEWER_LINK_HOURS=24
# how long events (GET /events, webhooks) and trajectory exports are kept
ZOO_EVENT_RETENTION_DAYS=7
ZOO_EXPORT_RETENTION_DAYS=7
# 1 lets webhooks reach private addresses (a receiver on your own network)
ZOO_WEBHOOK_ALLOW_PRIVATE=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DISCORD_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
