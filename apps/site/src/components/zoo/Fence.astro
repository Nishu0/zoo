---
import Sprite from "./Sprite.astro";

const rows = [
    {
        term: "Kernel isolation",
        desc: "Linux sandboxes run in Kata VMs; Mac and Windows guests use their native hypervisors. Tools and screens go through an authenticated gateway, never a public desktop port.",
    },
    {
        term: "Policies outside the guest",
        desc: "Tool permissions, network rules and app blocking per sandbox. Deny everything, then open one domain at a time.",
        code: 'box.set_network("deny")\nbox.add_rule("domain", "github.com")',
    },
    {
        term: "Secrets",
        desc: "Encrypted at rest with ZOO_SECRETS_KEY or your own KMS: AWS, Google Cloud or Vault. Injected on start, never shown again.",
    },
    {
        term: "Audit log",
        desc: "Every tool call is recorded with who, what and when.",
    },
];

const domains = [
    { host: "github.com", allow: true, x: 14, y: 12 },
    { host: "pypi.org", allow: true, x: 86, y: 12 },
    { host: "evil.example", allow: false, x: 14, y: 88 },
    { host: "pastebin.com", allow: false, x: 86, y: 88 },
];
---

<section class="zsection" id="fence">
    <div class="container">
        <header class="zhead" data-reveal>
            <span class="kicker">⚠ do not feed the agents</span>
            <h2>Built like it might bite</h2>
            <p>
                Agents are powerful and wrong in surprising ways. Zoo assumes both and builds the fences to match. Every
                fence is yours, on your hardware.
            </p>
        </header>

        <div class="split">
            <div class="rows">
                {
                    rows.map((r, i) => (
                        <article class="row" data-reveal style={`--d:${i * 0.06}s`}>
                            <h3>
                                <span class="post" aria-hidden="true" />
                                {r.term}
                            </h3>
                            <p>{r.desc}</p>
                            {r.code && (
                                <pre class="row-code"><code>{r.code}</code></pre>
                            )}
                        </article>
                    ))
                }
            </div>

            <div class="policy win" data-reveal style="--d:.12s" data-policy>
                <div class="win-bar">
                    <span class="lights"><i></i><i></i><i></i></span>
                    <span class="url">zoo.local/sandboxes/coder/policy</span>
                </div>

                <div class="yard" data-yard>
                    <div class="pen" aria-hidden="true">
                        <span class="gate pixel">api · the only gate</span>
                        <span class="inmate"><span class="bob"><Sprite name="snake" px={4} /></span></span>
                    </div>
                    {
                        domains.map((d) => (
                            <span
                                class="host mono"
                                data-host={d.host}
                                data-allow={d.allow ? "1" : "0"}
                                style={`left:${d.x}%; top:${d.y}%`}
                            >
                                {d.host}
                            </span>
                        ))
                    }
                </div>

                <div class="rules">
                    <p class="rules-h mono">egress · default <b>deny</b></p>
                    <ul role="list">
                        {
                            domains.map((d) => (
                                <li>
                                    <span class="mono">{d.host}</span>
                                    <button
                                        class="switch"
                                        type="button"
                                        role="switch"
                                        aria-checked={d.allow ? "true" : "false"}
                                        aria-label={`Allow ${d.host}`}
                                        data-switch={d.host}
                                    >
                                        <span />
                                    </button>
                                </li>
                            ))
                        }
                    </ul>
                    <p class="tally mono">
                        <span class="okc">passed <b data-passed>0</b></span>
                        <span class="noc">blocked at the fence <b data-blocked>0</b></span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const root = document.querySelector<HTMLElement>("[data-policy]")!;
    const yard = root.querySelector<HTMLElement>("[data-yard]")!;
    const hosts = [...root.querySelectorAll<HTMLElement>("[data-host]")];
    const passedEl = root.querySelector<HTMLElement>("[data-passed]")!;
    const blockedEl = root.querySelector<HTMLElement>("[data-blocked]")!;
    let passed = 0,
        blocked = 0;

    for (const sw of root.querySelectorAll<HTMLButtonElement>("[data-switch]")) {
        sw.addEventListener("click", () => {
            const on = sw.getAttribute("aria-checked") !== "true";
            sw.setAttribute("aria-checked", String(on));
            const h = hosts.find((x) => x.dataset.host === sw.dataset.switch)!;
            h.dataset.allow = on ? "1" : "0";
        });
    }

    function send() {
        const h = hosts[Math.floor(Math.random() * hosts.length)];
        const allow = h.dataset.allow === "1";
        const r = yard.getBoundingClientRect();
        const hr = h.getBoundingClientRect();
        const cx = r.width / 2,
            cy = r.height / 2;
        const tx = hr.left - r.left + hr.width / 2,
            ty = hr.top - r.top + hr.height / 2;
        const dot = document.createElement("span");
        dot.className = "packet";
        yard.appendChild(dot);
        const at = (t: number) => `translate(${cx + (tx - cx) * t}px, ${cy + (ty - cy) * t}px)`;
        if (allow) {
            const a = dot.animate([{ transform: at(0) }, { transform: at(0.92) }], {
                duration: 1100,
                easing: "linear",
            });
            a.onfinish = () => {
                dot.remove();
                h.classList.remove("hit");
                void h.offsetWidth;
                h.classList.add("hit");
                passedEl.textContent = String(++passed);
            };
        } else {
            const a = dot.animate(
                [
                    { transform: at(0), background: "#1f1c18" },
                    { transform: at(0.5), background: "#1f1c18", offset: 0.6 },
                    { transform: at(0.4), background: "#e0475b", opacity: 1, offset: 0.75 },
                    { transform: at(0.36), background: "#e0475b", opacity: 0 },
                ],
                { duration: 1100, easing: "ease-out" },
            );
            a.onfinish = () => {
                dot.remove();
                blockedEl.textContent = String(++blocked);
            };
            setTimeout(() => {
                const x = document.createElement("span");
                x.className = "nope pixel";
                x.textContent = "✕";
                x.style.transform = at(0.5);
                yard.appendChild(x);
                setTimeout(() => x.remove(), 700);
            }, 660);
        }
    }

    let timer: number | undefined;
    new IntersectionObserver(([e]) => {
        clearInterval(timer);
        if (e.isIntersecting && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
            timer = window.setInterval(send, 520);
        }
    }).observe(yard);
</script>

<style>
    .split {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(2rem, 5vw, 4rem);
        align-items: start;
    }

    .row {
        padding-block: 1.4rem;
        border-bottom: 2px dashed var(--line-2);
    }

    .row:first-child {
        padding-top: 0;
    }

    .row h3 {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 1.25rem;
        margin-bottom: 0.45rem;
    }

    .post {
        width: 10px;
        height: 16px;
        background: #a8764a;
        box-shadow: inset -3px 0 0 #7a5132;
        clip-path: polygon(0 3px, 50% 0, 100% 3px, 100% 100%, 0 100%);
    }

    .row p {
        color: var(--ink-2);
        max-width: 54ch;
    }

    .row-code {
        margin-top: 0.8rem;
        padding: 0.75rem 1rem;
        background: var(--term);
        color: #a6dba0;
        border-radius: 8px;
        font-size: 0.8rem;
        white-space: pre;
        overflow-x: auto;
    }

    .policy {
        position: sticky;
        top: 6rem;
        border: 2px solid var(--ink);
        box-shadow: 6px 6px 0 var(--ink);
    }

    .yard {
        position: relative;
        height: 300px;
        background:
            radial-gradient(circle at 50% 50%, #e9f3dc 0 30%, transparent 30.5%),
            repeating-linear-gradient(45deg, rgb(0 0 0 / 0.025) 0 6px, transparent 6px 12px),
            #f3efe4;
        overflow: hidden;
    }

    .pen {
        position: absolute;
        left: 30%;
        right: 30%;
        top: 26%;
        bottom: 26%;
        background: #b7d99a;
        /* fence posts all the way round */
        border: 6px solid transparent;
        border-image: repeating-linear-gradient(90deg, #a8764a 0 6px, #7a5132 6px 8px, transparent 8px 12px) 6;
        box-shadow: 0 0 0 2px #7a5132;
        display: grid;
        place-items: center;
    }

    .gate {
        position: absolute;
        bottom: -14px;
        left: 50%;
        translate: -50% 0;
        white-space: nowrap;
        padding: 0.2rem 0.45rem;
        background: var(--yellow);
        border: 2px solid var(--ink);
        font-size: 0.58rem;
        text-transform: uppercase;
        z-index: 2;
    }

    .host {
        position: absolute;
        translate: -50% -50%;
        font-size: 0.72rem;
        padding: 0.3rem 0.6rem;
        border-radius: 999px;
        background: var(--paper);
        border: 1.5px solid var(--ink);
        white-space: nowrap;
        transition: background 0.25s, color 0.25s;
        z-index: 2;
    }

    .host[data-allow="0"] {
        background: #f6dfe1;
        color: #9b2335;
        border-style: dashed;
        text-decoration: line-through;
    }

    .host:global(.hit) {
        animation: hit 0.4s var(--ease-spring);
    }

    @keyframes hit {
        40% {
            scale: 1.12;
            background: #d7f0dc;
        }
    }

    .yard :global(.packet) {
        position: absolute;
        left: -4px;
        top: -4px;
        width: 8px;
        height: 8px;
        background: var(--ink);
        z-index: 1;
    }

    .yard :global(.nope) {
        position: absolute;
        left: -6px;
        top: -10px;
        color: var(--red);
        font-size: 1rem;
        z-index: 3;
        animation: nope 0.7s var(--ease-out) forwards;
    }

    @keyframes nope {
        to {
            opacity: 0;
            translate: 0 -14px;
        }
    }

    .rules {
        padding: 1rem 1.1rem 1.1rem;
        border-top: 2px solid var(--ink);
    }

    .rules-h {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--ink-3);
        margin-bottom: 0.5rem;
    }

    .rules-h b {
        color: var(--red);
        font-weight: 400;
    }

    .rules ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.35rem 1.2rem;
    }

    .rules li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8rem;
        padding: 0.3rem 0;
    }

    .switch {
        width: 38px;
        height: 22px;
        border-radius: 999px;
        border: 2px solid var(--ink);
        background: #f0d5d8;
        padding: 0;
        cursor: pointer;
        position: relative;
        transition: background 0.2s;
        flex: none;
    }

    .switch span {
        position: absolute;
        top: 2px;
        left: 2px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--ink);
        transition: transform 0.25s var(--ease-spring);
    }

    .switch[aria-checked="true"] {
        background: #9fdcae;
    }

    .switch[aria-checked="true"] span {
        transform: translateX(16px);
    }

    .tally {
        margin-top: 0.8rem;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-size: 0.72rem;
        color: var(--ink-3);
    }

    .tally b {
        font-weight: 400;
        color: var(--ink);
    }

    .noc b {
        color: var(--red);
    }

    @media (max-width: 900px) {
        .split {
            grid-template-columns: 1fr;
        }
        .policy {
            position: static;
        }
    }

    @media (max-width: 480px) {
        .rules ul {
            grid-template-columns: 1fr;
        }
        .host {
            font-size: 0.62rem;
        }
        .pen {
            left: 26%;
            right: 26%;
        }
    }
</style>
