---
import Sprite from "./Sprite.astro";

const links = [
    { href: "#enclosures", label: "Enclosures" },
    { href: "#live", label: "Live view" },
    { href: "#wires", label: "Connect" },
    { href: "#fence", label: "Security" },
    { href: "/docs/", label: "Docs" },
];
---

<header class="nav" data-nav>
    <div class="container bar">
        <a class="brand" href="#top" aria-label="Zoo — home">
            <Sprite name="keeper" px={2} />
            <span class="word">zoo</span>
        </a>

        <nav class="links" aria-label="Main">
            {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>

        <div class="right">
            <a class="gh" href="https://github.com/chann44/zoo" target="_blank" rel="noreferrer">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
                    ><path
                        fill="currentColor"
                        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                    ></path></svg
                >
                <span>GitHub</span>
            </a>
            <a class="btn-yellow cta" href="/docs/get-started/quickstart/">Get started</a>
            <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" data-burger>
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
    <nav class="drawer" aria-label="Mobile" data-drawer>
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="https://github.com/chann44/zoo" target="_blank" rel="noreferrer">GitHub ↗</a>
    </nav>
</header>

<script>
    const nav = document.querySelector<HTMLElement>("[data-nav]")!;
    const burger = nav.querySelector<HTMLButtonElement>("[data-burger]")!;
    const night = document.querySelector<HTMLElement>(".night");
    const onScroll = () => {
        nav.classList.toggle("scrolled", scrollY > 12);
        // past the sunset the bar turns into a night bar
        const t = night ? night.getBoundingClientRect().top + night.offsetHeight * 0.18 : Infinity;
        nav.classList.toggle("dark", t < 68);
    };
    addEventListener("scroll", onScroll, { passive: true });
    onScroll();
    burger.addEventListener("click", () => {
        const open = nav.classList.toggle("open");
        burger.setAttribute("aria-expanded", String(open));
    });
    nav.querySelectorAll("[data-drawer] a").forEach((a) =>
        a.addEventListener("click", () => {
            nav.classList.remove("open");
            burger.setAttribute("aria-expanded", "false");
        }),
    );
</script>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 60;
        transition:
            background 0.25s,
            box-shadow 0.25s;
    }

    .nav.scrolled,
    .nav.open {
        background: color-mix(in oklab, var(--paper) 72%, transparent);
        backdrop-filter: blur(12px) saturate(1.3);
        -webkit-backdrop-filter: blur(12px) saturate(1.3);
        box-shadow: 0 1px 0 var(--line);
    }

    .nav.dark {
        --ink: #eef0fa;
        --ink-2: #c3c8e2;
        --paper: #121a33;
        --line: rgb(255 255 255 / 0.08);
        color: var(--ink);
    }

    .nav.dark .brand :global(.sprite) {
        filter: invert(1) hue-rotate(180deg);
    }

    .bar {
        display: flex;
        align-items: center;
        gap: 2rem;
        height: 68px;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
    }

    .brand :global(.sprite) {
        transition: transform 0.3s var(--ease-spring);
    }

    .brand:hover :global(.sprite) {
        transform: translateY(-3px) rotate(-6deg);
    }

    .word {
        font-size: 1.35rem;
        font-weight: 700;
        font-stretch: 112%;
        letter-spacing: -0.03em;
    }

    .links {
        display: flex;
        gap: 1.6rem;
        font-size: 0.92rem;
        color: var(--ink-2);
    }

    .links a {
        text-decoration: none;
        position: relative;
    }

    .links a:hover {
        color: var(--ink);
    }

    .links a::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -4px;
        height: 2px;
        background: var(--ink);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.25s var(--ease-out);
    }

    .links a:hover::after {
        transform: scaleX(1);
    }

    .right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .gh {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.9rem;
        text-decoration: none;
        color: var(--ink-2);
    }

    .gh:hover {
        color: var(--ink);
    }

    .cta {
        padding: 0.6rem 1rem 0.55rem;
        font-size: 0.74rem;
    }

    .burger {
        display: none;
        width: 40px;
        height: 40px;
        border: 0;
        background: none;
        padding: 10px 8px;
        cursor: pointer;
        flex-direction: column;
        justify-content: space-between;
    }

    .burger span {
        display: block;
        height: 2px;
        background: var(--ink);
        transition: transform 0.25s var(--ease-out), opacity 0.2s;
    }

    .open .burger span:nth-child(1) {
        transform: translateY(8px) rotate(45deg);
    }
    .open .burger span:nth-child(2) {
        opacity: 0;
    }
    .open .burger span:nth-child(3) {
        transform: translateY(-8px) rotate(-45deg);
    }

    .drawer {
        display: none;
    }

    @media (max-width: 900px) {
        .links,
        .gh {
            display: none;
        }
        .burger {
            display: flex;
        }
        .open .drawer {
            display: flex;
            flex-direction: column;
            padding: 0.5rem var(--gutter) 1.2rem;
        }
        .drawer a {
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--line);
            text-decoration: none;
            font-size: 1.05rem;
        }
    }

    @media (max-width: 420px) {
        .cta {
            display: none;
        }
    }
</style>
