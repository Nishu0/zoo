---
const installCmd =
    "curl -fsSL https://github.com/chann44/zoo/releases/latest/download/install.sh | sudo bash -s -- --admin-email you@example.com";

const facts = ["microVM per sandbox", "mcp · rest · python sdk", "linux · macos · windows"];
---

<section class="hero" id="top">
    <div class="container">
        <div class="hero-copy">
            <p class="eyebrow" data-reveal>
                <span class="dot ok pulse"></span>
                self-hosted · open source
            </p>

            <h1 data-reveal style="--d: 0.06s">
                Every agent gets its own computer
            </h1>

            <p class="lead" data-reveal style="--d: 0.12s">
                Zoo gives AI agents <strong>Linux, macOS and Windows desktops</strong>, browsers and
                shells — each sealed in its own microVM. Agents drive them over MCP, REST or the
                Python SDK. <strong>You watch, and take over, from the dashboard.</strong>
            </p>

            <div class="install" data-reveal style="--d: 0.18s">
                <div class="install-head">
                    <span class="label">quickstart — ubuntu / debian, kvm</span>
                    <button class="copy-btn" data-copy={installCmd} type="button">
                        <span class="copy-label">copy</span>
                    </button>
                </div>
                <pre><code>{installCmd}</code></pre>
            </div>

            <ul class="facts" data-reveal style="--d: 0.24s">
                {facts.map((f) => <li>{f}</li>)}
            </ul>
        </div>
    </div>
</section>

<style>
    .hero {
        padding-block: clamp(4.5rem, 10vw, 8rem) clamp(4.5rem, 8vw, 7rem);
    }

    .hero-copy {
        max-width: 880px;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        margin: 0 0 1.8rem;
        font-family: var(--font-mono);
        font-size: 0.74rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-dim);
    }

    h1 {
        font-size: clamp(2.2rem, 1.1rem + 5vw, 4.9rem);
        font-stretch: 124%;
        font-weight: 660;
        line-height: 0.98;
        letter-spacing: -0.014em;
        text-transform: uppercase;
        margin-bottom: 1.7rem;
        max-width: min(14ch, 100%);
    }

    .lead {
        margin-bottom: 2.4rem;
    }

    /* install command */

    .install {
        border: 1px solid var(--line-strong);
        background: var(--bg-1);
        width: 100%;
        max-width: 720px;
        text-align: left;
    }

    .install-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.55rem 0.75rem 0.55rem 1rem;
        border-bottom: 1px solid var(--line);
    }

    .copy-btn {
        background: none;
        border: 1px solid var(--line-strong);
        color: var(--text-dim);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        padding: 0.3rem 0.7rem;
        cursor: pointer;
        transition:
            color 0.15s var(--ease-out),
            border-color 0.15s var(--ease-out);
    }

    .copy-btn:hover,
    .copy-btn.did {
        color: var(--teal);
        border-color: var(--teal);
    }

    .install pre {
        padding: 1.1rem 1.2rem;
        color: var(--text);
        white-space: pre-wrap;
        word-break: break-all;
    }

    /* fact chips */

    .facts {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.6rem;
        margin: 2rem 0 0;
        padding: 0;
    }

    .facts li {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-faint);
        padding: 0.5rem 0.9rem;
        border: 1px solid var(--line);
    }
</style>
