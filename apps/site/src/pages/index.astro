---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Overview from "../components/Overview.astro";
import LiveView from "../components/LiveView.astro";
import Sandboxes from "../components/Sandboxes.astro";
import Agents from "../components/Agents.astro";
import Security from "../components/Security.astro";
import Deploy from "../components/Deploy.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
    <Header />
    <main id="main">
        <Hero />
        <Overview />
        <LiveView />
        <Sandboxes />
        <Agents />
        <Security />
        <Deploy />
        <Faq />
        <Cta />
    </main>
    <Footer />
</Layout>
