---
const faqs = [
    {
        q: "What is Zoo, exactly?",
        a: "A self-hosted service that gives AI agents disposable computers: Linux, macOS and Windows desktops, browsers and code shells — each in its own microVM with its own kernel. Agents drive them over MCP, REST or the Python SDK; you watch and take over from the dashboard.",
    },
    {
        q: "What do I need to run it?",
        a: "A fresh Ubuntu or Debian server with KVM — bare metal, or a cloud VM with nested virtualization. One script installs Docker, Kata Containers and the whole stack. macOS sandboxes need a Mac server; Windows sandboxes need a Windows server with Hyper-V.",
    },
    {
        q: "How do agents connect?",
        a: "One MCP server at /mcp/ with an API key, plain REST endpoints, or the Python SDK. Every tool is registered once and exposed identically over all three, so switching is cheap.",
    },
    {
        q: "Can I watch what agents are doing?",
        a: "Yes. Live view streams any sandbox screen in the browser, and you can take over with your own mouse and keyboard. Every tool call is logged, and agent actions replay with the screenshots they were decided on.",
    },
    {
        q: "Where does my data live?",
        a: "On your servers. Zoo is self-hosted end to end — sandboxes, dashboard, database and secrets all run on your hardware. Secrets are encrypted at rest, with optional AWS, Google Cloud or Vault KMS.",
    },
    {
        q: "Does it work with Claude Code?",
        a: "Yes — code sandboxes ship with Claude Code preinstalled. Add your Anthropic key as an encrypted secret and run headless sessions with box.claude().",
    },
    {
        q: "Can it run on more than one server?",
        a: "Yes. Register remote Linux servers, Mac and Windows hosts, and move sandboxes between them — or run the Helm chart on Kubernetes, with sandboxes as Kata pods.",
    },
];
---

<section class="section" id="faq">
    <div class="container narrow">
        <header class="section-head" data-reveal>
            <p class="section-index"><span class="idx">07</span> / faq</p>
            <h2>Questions, answered plainly</h2>
        </header>

        <div class="faq" data-reveal style="--d: 0.08s">
            {
                faqs.map((f) => (
                    <details>
                        <summary>
                            <span>{f.q}</span>
                            <span class="plus" aria-hidden="true" />
                        </summary>
                        <p>{f.a}</p>
                    </details>
                ))
            }
        </div>
    </div>
</section>

<style>
    .narrow {
        max-width: 820px;
    }

    .faq details {
        border-bottom: 1px solid var(--line);
    }

    .faq details:first-child {
        border-top: 1px solid var(--line-strong);
    }

    .faq summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 1.15rem 0.2rem;
        cursor: pointer;
        list-style: none;
        font-weight: 560;
        font-size: 1.02rem;
        transition: color 0.15s var(--ease-out);
    }

    .faq summary::-webkit-details-marker {
        display: none;
    }

    .faq summary:hover {
        color: var(--teal);
    }

    .plus {
        position: relative;
        width: 14px;
        height: 14px;
        flex: none;
    }

    .plus::before,
    .plus::after {
        content: "";
        position: absolute;
        background: var(--text-faint);
        transition: background 0.15s var(--ease-out);
    }

    .plus::before {
        left: 0;
        right: 0;
        top: 6px;
        height: 2px;
    }

    .plus::after {
        top: 0;
        bottom: 0;
        left: 6px;
        width: 2px;
        transition: scale 0.2s var(--ease-out);
    }

    details[open] .plus::after {
        scale: 1 0;
    }

    details[open] .plus::before {
        background: var(--teal);
    }

    .faq p {
        padding: 0 0.2rem 1.3rem;
        color: var(--text-dim);
        font-size: 0.95rem;
        max-width: 64ch;
    }
</style>
