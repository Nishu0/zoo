---
const boxes = [
    { name: "research", kind: "desktop · linux", state: "running", cls: "ok" },
    { name: "demo", kind: "desktop · linux", state: "running", cls: "ok" },
    { name: "invoice", kind: "desktop · windows", state: "running", cls: "ok" },
    { name: "coder", kind: "code · linux", state: "stopped", cls: "" },
];
---

<section class="section" id="live">
    <div class="container">
        <header class="section-head" data-reveal>
            <p class="section-index"><span class="idx">02</span> / live view</p>
            <h2>Watch every move. Step in anytime.</h2>
            <p class="section-lede">
                The dashboard streams any sandbox's screen in your browser. When the agent goes
                sideways, your mouse and keyboard drop straight into the machine.
            </p>
        </header>

        <div class="split">
            <div class="dash" data-reveal aria-hidden="true">
                <div class="dash-bar">
                    <span class="mono">research — desktop · linux</span>
                    <span class="live mono"><span class="dot ok pulse"></span> live</span>
                </div>

                <div class="dash-body">
                    <ul class="boxes mono" role="list">
                        {
                            boxes.map((b) => (
                                <li>
                                    <span class="dot {b.cls}" />
                                    <span class="name">{b.name}</span>
                                    <span class="kind">{b.kind}</span>
                                </li>
                            ))
                        }
                    </ul>

                    <div class="viewport">
                        <div class="crosshair" style="--cx: 52%; --cy: 44%">
                            <span class="coords mono">x 666 · y 316</span>
                        </div>
                        <span class="vp-label mono">noVNC · 1280×720</span>
                    </div>
                </div>

                <div class="dash-foot">
                    <span class="take mono">take over</span>
                    <span class="halt mono">stop</span>
                    <span class="logged mono">audit log · 1,284 calls</span>
                </div>
            </div>

            <ul class="points" data-reveal style="--d: 0.12s">
                <li>
                    <h3>See what the agent sees</h3>
                    <p>The live view streams the sandbox screen in the browser — no client install, no port juggling.</p>
                </li>
                <li>
                    <h3>Take the wheel</h3>
                    <p>Take over mid-task with your own mouse and keyboard, then hand it back. The agent picks up from the new screen state.</p>
                </li>
                <li>
                    <h3>Nothing happens off the record</h3>
                    <p>Every tool call lands in the activity log. Agent actions store the screenshot they were decided on, so tasks replay step by step.</p>
                </li>
            </ul>
        </div>
    </div>
</section>

<style>
    .split {
        display: grid;
        grid-template-columns: 1.35fr 1fr;
        gap: clamp(2.5rem, 5vw, 4.5rem);
        align-items: center;
    }

    /* dashboard mock */

    .dash {
        border: 1px solid var(--line-strong);
        background: var(--bg-1);
    }

    .dash-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--line);
        font-size: 0.74rem;
        letter-spacing: 0.06em;
        color: var(--text-dim);
        text-transform: lowercase;
    }

    .live {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--ok);
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .dash-body {
        display: grid;
        grid-template-columns: 168px 1fr;
        min-height: 300px;
    }

    .boxes {
        list-style: none;
        margin: 0;
        padding: 0.5rem 0;
        border-right: 1px solid var(--line);
        font-size: 0.72rem;
    }

    .boxes li {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.5rem 0.9rem;
        color: var(--text-dim);
    }

    .boxes li:first-child {
        background: var(--bg-2);
        color: var(--text);
        box-shadow: inset 2px 0 0 var(--teal);
    }

    .boxes .kind {
        margin-left: auto;
        color: var(--text-faint);
        font-size: 0.64rem;
        display: none;
    }

    .viewport {
        position: relative;
        overflow: hidden;
        background-image:
            repeating-linear-gradient(
                to right,
                color-mix(in oklab, var(--line) 55%, transparent) 0 1px,
                transparent 1px 32px
            ),
            repeating-linear-gradient(
                to bottom,
                color-mix(in oklab, var(--line) 55%, transparent) 0 1px,
                transparent 1px 32px
            );
    }

    .crosshair {
        position: absolute;
        left: var(--cx);
        top: var(--cy);
        width: 0;
        height: 0;
    }

    .crosshair::before,
    .crosshair::after {
        content: "";
        position: absolute;
        background: color-mix(in oklab, var(--teal) 80%, transparent);
    }

    .crosshair::before {
        left: -18px;
        right: -18px;
        top: 0;
        height: 1px;
    }

    .crosshair::after {
        top: -18px;
        bottom: -18px;
        left: 0;
        width: 1px;
    }

    .coords {
        position: absolute;
        top: 10px;
        left: 14px;
        white-space: nowrap;
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        color: var(--teal);
        background: var(--bg-1);
        padding: 0.2rem 0.5rem;
        border: 1px solid var(--line-strong);
    }

    .vp-label {
        position: absolute;
        right: 10px;
        bottom: 10px;
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        color: var(--text-faint);
        text-transform: uppercase;
    }

    .dash-foot {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.6rem 1rem;
        border-top: 1px solid var(--line);
    }

    .take {
        padding: 0.35rem 0.85rem;
        background: var(--teal-deep);
        color: var(--teal-ink);
        font-size: 0.66rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .halt {
        padding: 0.35rem 0.85rem;
        border: 1px solid var(--line-strong);
        color: var(--text-dim);
        font-size: 0.66rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .logged {
        margin-left: auto;
        font-size: 0.64rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-faint);
    }

    /* copy points */

    .points {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .points li {
        padding-block: 1.5rem;
        border-bottom: 1px solid var(--line);
    }

    .points li:first-child {
        border-top: 1px solid var(--line-strong);
    }

    .points h3 {
        font-size: 1.1rem;
        font-weight: 620;
        margin-bottom: 0.5rem;
    }

    .points p {
        color: var(--text-dim);
        font-size: 0.95rem;
    }

    @media (max-width: 960px) {
        .split {
            grid-template-columns: 1fr;
        }

        .boxes .kind {
            display: none;
        }
    }
</style>
